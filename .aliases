# Aliases

# Editor
alias v="nvim"
alias vi="nvim"
alias vim="nvim"

# Common shortcuts
alias ll="ls -la"
alias la="ls -a"
alias ..="cd .."
alias ...="cd ../.."

# Git shortcuts
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gl="git log --oneline -10"
alias gd="git diff"
